# Copy to .env. Never commit credentials.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://bc2026:CHANGE_ME@127.0.0.1:5432/bc2026
TEST_DATABASE_URL=

# OpenAI is the selected production provider. Set an API model available to your account.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
LLM_MODEL_DIALOGUE=gpt-6.1-terra
LLM_MODEL_EVALUATION=gpt-6.1-sol
OPENAI_API_KEY=
LLM_TIMEOUT_MS=90000
DEMO_MODE=false
GUEST_ACCESS_ENABLED=false

# Magic-link email delivery. SMTP_SECURE=true normally uses port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Stripe test-mode credentials and recurring prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Deployment: public hostname for Caddy, PostgreSQL service credentials.
PUBLIC_HOSTNAME=
POSTGRES_DB=bc2026
POSTGRES_USER=bc2026
POSTGRES_PASSWORD=

# Explicit opt-in for tests that call paid external APIs.
LLM_LIVE=0
